<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Snap2HTML</RootNamespace>
    <AssemblyName>Snap2HTML</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>4.0.0</Version>
    <Company>Enova IT Solutions S.L.</Company>
    <Product>Snap2HTML</Product>
    <Copyright>Copyright © RL Vision 2011-2020, Enova IT Solutions S.L. 2025-2026</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
    <Content Include="ReadMe.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="template.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SQL Server Express LocalDB MSI embedded for fully offline installation -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Installers\SqlLocalDB.msi">
      <LogicalName>Snap2HTML.Resources.Installers.SqlLocalDB.msi</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="z440.atl.core" Version="7.11.0" />
    <PackageReference Include="SharpCompress" Version="0.47.3" />
    <PackageReference Include="OpenMcdf" Version="3.1.3" />
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- WMI for diagnostic report -->
    <PackageReference Include="System.Management" Version="10.0.7" />
  </ItemGroup>

</Project>